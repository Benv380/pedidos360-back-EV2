# Copiar como .env (este archivo NO se sube a GitHub) y completar.

# ---------- RabbitMQ ----------
RABBITMQ_USER=pedidos
RABBITMQ_PASSWORD=cambiar-esta-clave
# Debe ser igual en ambos nodos (el compose lo usa para los dos). Cualquier texto largo.
RABBITMQ_ERLANG_COOKIE=cambiar-por-un-texto-largo-y-secreto

# ---------- Gateway ----------
# Puerto público del backend. Local: 8080 · VM en la nube: 80
GATEWAY_PORT=8080

# ---------- Base de datos ----------
# Local (contenedor postgres):
DB_URL=jdbc:postgresql://postgres:5432/pedidos
# Azure Database for PostgreSQL (Flexible Server):
# DB_URL=jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/pedidos?sslmode=require
DB_USER=pedidos
DB_PASSWORD=cambiar-esta-clave

# ---------- Seguridad JWT: se aceptan tokens de AMBOS IDaaS ----------
# true en la nube. false solo para probar en local sin IDaaS.
SEGURIDAD_HABILITADA=true

# Azure · Microsoft Entra External ID (copiar "issuer" y "jwks_uri" del documento discovery)
ENTRA_ISSUER=https://<TENANT_ID>.ciamlogin.com/<TENANT_ID>/v2.0
ENTRA_JWK_SET_URI=https://<SUBDOMINIO>.ciamlogin.com/<TENANT_ID>/discovery/v2.0/keys
ENTRA_CLIENT_ID=<CLIENT_ID_ENTRA>

# AWS · Amazon Cognito
COGNITO_ISSUER=https://cognito-idp.<REGION>.amazonaws.com/<USER_POOL_ID>
COGNITO_JWK_SET_URI=
COGNITO_CLIENT_ID=<APP_CLIENT_ID_COGNITO>

# Opcional: rol exigido para /api/admin/** (App Role de Entra o grupo de Cognito). Vacío = cualquier usuario.
ROL_ADMIN=
# Orígenes permitidos (frontend). Separados por coma.
CORS_ORIGENES=http://localhost:4200,https://<tu-static-web-app>.azurestaticapps.net,https://<tu-app>.amplifyapp.com
